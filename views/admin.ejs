<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>

  <!-- Menú de Navegación -->
  <nav class="blue darken-3">
    <div class="nav-wrapper container">
      <a href="/" class="brand-logo">Tecsup Games</a>
      <ul id="nav-mobile" class="right hide-on-med-and-down">
        <li><a href="/">Inicio</a></li>
        <li><a href="/about">Acerca de</a></li>
        <li><a href="/contact">Contacto</a></li>
        <li><a href="/games">Videojuegos</a></li>
        <li class="active"><a href="/admin">Admin</a></li>
      </ul>
    </div>
  </nav>

  <!-- Contenido Principal -->
  <div class="container" style="margin-top: 40px;">
    <div class="row valign-wrapper" style="margin-bottom: 30px;">
      <div class="col s8">
        <h4 class="blue-text text-darken-3" style="font-weight: 600; margin: 0;">Mensajes Recibidos</h4>
      </div>
      <div class="col s4 right-align">
        <a href="/contact" class="waves-effect waves-light btn blue darken-2">Nuevo Mensaje</a>
      </div>
    </div>

    <!-- Verificación de Mensajes en Memoria -->
    <% if (messages.length === 0) { %>
      <div class="card-panel yellow lighten-4 center-align">
        <p class="flow-text orange-text text-darken-4" style="margin: 0;">📭 No hay mensajes registrados en este momento.</p>
      </div>
    <% } else { %>
      <ul class="collection z-depth-1" style="border-radius: 8px; border: none; overflow: hidden;">
        <% messages.forEach(m => { %>
          <li class="collection-item avatar" style="padding-left: 30px; min-height: auto; border-bottom: 1px solid #e0e0e0;">
            <span class="title blue-text text-darken-2" style="font-weight: bold; font-size: 1.1rem;"><%= m.nombre %></span>
            <p class="grey-text text-darken-1" style="margin: 4px 0;"><%= m.email %></p>
            <div class="card-panel grey lighten-5" style="margin: 10px 0 0 0; padding: 12px; box-shadow: none !important; border-left: 4px solid #1565c0; border-radius: 0 4px 4px 0;">
              <span class="black-text" style="font-style: italic;"><%= m.mensaje %></span>
            </div>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </div>
</body>
</html>
