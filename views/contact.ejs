<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>

  <!-- Menú de Navegación -->
  <nav class="blue darken-3">
    <div class="nav-wrapper container">
      <a href="/" class="brand-logo">Tecsup Games</a>
      <ul id="nav-mobile" class="right hide-on-med-and-down">
        <li><a href="/">Inicio</a></li>
        <li><a href="/about">Acerca de</a></li>
        <li class="active"><a href="/contact">Contacto</a></li>
        <li><a href="/games">Videojuegos</a></li>
        <li><a href="/admin">Admin</a></li>
      </ul>
    </div>
  </nav>

  <!-- Contenido Principal -->
  <div class="container" style="margin-top: 40px; max-width: 600px;">
    <div class="card-panel">
      <h4 class="center-align blue-text text-darken-3" style="font-weight: 600; margin-bottom: 30px;">Formulario de Contacto</h4>
      
      <form action="/contact" method="POST">
        <div class="input-field">
          <input id="nombre" type="text" name="nombre" required>
          <label for="nombre">Nombre Completo</label>
        </div>
        
        <div class="input-field">
          <input id="email" type="email" name="email" required>
          <label for="email">Correo Electrónico</label>
        </div>
        
        <div class="input-field">
          <textarea id="mensaje" class="materialize-textarea" name="mensaje" required></textarea>
          <label for="mensaje">Mensaje o Sugerencia</label>
        </div>
        
        <div class="row" style="margin-top: 30px; margin-bottom: 0;">
          <div class="col s6">
            <a href="/" class="waves-effect waves-light btn grey lighten-1 black-text" style="width: 100%;">Volver</a>
          </div>
          <div class="col s6">
            <button type="submit" class="waves-effect waves-light btn blue darken-2" style="width: 100%;">Enviar</button>
          </div>
        </div>
      </form>
    </div>
  </div>
</body>
</html>
